{
  "expo": {
    "name": "bolt-expo-nativewind",
    "slug": "bolt-expo-nativewind",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": ["expo-router", "expo-font", "expo-web-browser"],
    "experiments": {
      "typedRoutes": true,
      // Served under the homepage's /games/world-explorer reverse-proxy
      // subpath: prefix asset URLs and the router base with it. The game's
      // own vercel.json rewrites the subpath back to / so the standalone
      // deployment keeps working too.
      "baseUrl": "/games/world-explorer"
    }
  }
}
